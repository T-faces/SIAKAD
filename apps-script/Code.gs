const SPREADSHEET_ID="GANTI_DENGAN_ID_SPREADSHEET";const SHEETS={Users:["ID","Username","Password","Nama","Role","Email","Status","CreatedAt"],Students:["ID","NISN","Nama","Kelas","JK","Email","Status"],Teachers:["ID","NIP","Nama","Mapel","Email","Status"],Classes:["ID","Kode","Nama Kelas","Wali Kelas","Tahun Ajaran"],Subjects:["ID","Kode","Nama","Guru","KKM"],Courses:["ID","Kode","Nama Kursus","Guru","Deskripsi","Status"],Materials:["ID","Kursus","Judul","Deskripsi","URL","Tanggal","Status"],Assignments:["ID","Kursus","Judul","Deskripsi","URL","Batas Waktu","Status"],Submissions:["ID","AssignmentID","SiswaID","JawabanURL","TanggalKumpul","Status"],Grades:["ID","Siswa","Mapel","Tugas","UTS","UAS","Nilai Akhir","Semester","Tahun Ajaran"],Attendance:["ID","Tanggal","Siswa","Kelas","Mapel","Status","Keterangan"],Announcements:["ID","Judul","Isi","Tanggal","Status"],Settings:["Key","Value"],ActivityLog:["Timestamp","Username","Action","Entity","RecordID"]};
function setupDatabase(){const s=SpreadsheetApp.openById(SPREADSHEET_ID);Object.entries(SHEETS).forEach(([n,h])=>{let sh=s.getSheetByName(n)||s.insertSheet(n);if(sh.getLastRow()===0)sh.appendRow(h)});const u=s.getSheetByName("Users");if(u.getLastRow()<2)u.getRange(2,1,3,8).setValues([["U001","admin","admin123","Administrator","Admin","","Aktif",new Date()],["U002","guru","guru123","Guru Demo","Guru","","Aktif",new Date()],["U003","siswa","siswa123","Siswa Demo","Siswa","","Aktif",new Date()]]);return"Database siap"}
function doGet(){return out({success:true,message:"SIAKAD LMS API aktif"})}function doPost(e){try{const b=JSON.parse(e.postData.contents||"{}");if(b.action==="login")return out(login(b.payload));if(b.action==="dashboard")return out(dashboard());if(b.action==="list")return out({success:true,data:rows(b.payload.entity)});if(b.action==="create")return out(create(b.payload.entity,b.payload.data));return out({success:false,message:"Action tidak dikenal"})}catch(x){return out({success:false,message:x.message})}}
function out(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}function rows(n){const sh=SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(n);if(!sh||sh.getLastRow()<2)return[];const v=sh.getDataRange().getValues(),h=v.shift();return v.filter(r=>r.some(x=>x!=="")).map(r=>Object.fromEntries(h.map((k,i)=>[k,r[i]])))}function login(p){const u=rows("Users").find(x=>String(x.Username)===String(p.username)&&String(x.Password)===String(p.password)&&x.Status==="Aktif");return u?{success:true,user:{username:u.Username,nama:u.Nama,role:u.Role,email:u.Email}}:{success:false,message:"Username/password salah"}}function dashboard(){return{success:true,stats:{students:rows("Students").length,teachers:rows("Teachers").length,courses:rows("Courses").length,assignments:rows("Assignments").length}}}function create(n,d){if(!SHEETS[n])throw Error("Entity tidak valid");SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(n).appendRow(SHEETS[n].map(k=>d[k]??""));return{success:true,message:"Data berhasil ditambahkan"}}